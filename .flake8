[flake8]
extend-ignore =
    E203
max-line-length = 120
per-file-ignores =
    */__init__.py: F401
    *__init__.py: F401
    OlivOS/hook*.py: F401
    *hook*.py: F401
    OlivOS/core/inlineData/*: E501
    *inlineData*: E501
    *qqGuildv2SDK.py: F403, F405
    *qqGuildv2SDKGroup.py: F403, F405
    *qqGuildv2SDKGuild.py: F403, F405
    *qqGuildv2SDKGuildPrivate.py: F403, F405
    *qqGuildv2SDKPrivate.py: F403, F405
exclude =
    OlivOS/thirdPartyModule/*
    build/*
    dist/*
    main.*build/*
