#!/bin/sh
# OlivOS/webUI/staticData.py 由 main/dev 合并后的 CI 自动重新生成，禁止人工提交。
# 启用本目录钩子：git config core.hooksPath script/git-hooks
git rev-parse --verify HEAD -q >/dev/null || exit 0
if ! git diff --cached --quiet -- OlivOS/webUI/staticData.py; then
    echo '[pre-commit] OlivOS/webUI/staticData.py 是 CI 自动生成文件，请勿提交。'
    echo '  取消暂存：git restore --staged -- OlivOS/webUI/staticData.py'
    echo '  还原内容：git restore --source=HEAD -- OlivOS/webUI/staticData.py'
    exit 1
fi
exit 0
